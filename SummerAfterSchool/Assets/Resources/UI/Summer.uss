* { -unity-font-style: normal; }
.screen { position: absolute; left: 0; top: 0; right: 0; bottom: 0; color: rgb(247, 242, 226); }
.topbar { position: absolute; top: 24px; left: 36px; right: 36px; height: 44px; flex-direction: row; align-items: center; justify-content: space-between; }
.brand { font-size: 18px; -unity-font-style: bold; letter-spacing: 3px; padding: 10px 14px; border-radius: 8px; background-color: rgba(22, 38, 41, .80); }
.top-actions { flex-direction: row; }
.small-button { background-color: rgba(23, 36, 42, 0.82); color: rgb(238, 231, 210); border-width: 1px; border-color: rgba(238, 231, 210, .22); border-radius: 10px; font-size: 14px; height: 40px; padding-left: 18px; padding-right: 18px; margin-left: 8px; }
Button { transition-property: background-color, border-color, scale; transition-duration: 0.15s; cursor: pointer; }
Button:hover { border-color: rgb(246, 201, 103); background-color: rgb(53, 72, 76); }
Button:active { scale: .98 .98; }
.hub-hero { position: absolute; left: 48px; top: 160px; width: 450px; padding: 30px; background-color: rgba(21, 38, 44, .89); border-left-width: 3px; border-left-color: rgb(239, 188, 83); border-radius: 18px; }
.eyebrow { font-size: 13px; letter-spacing: 4px; color: rgb(238, 193, 102); margin-bottom: 22px; }
.hero-title { font-size: 76px; -unity-font-style: bold; letter-spacing: 6px; margin-bottom: 12px; }
.hero-subtitle { font-size: 23px; color: rgb(247, 239, 218); margin-bottom: 18px; }
.body { font-size: 15px; white-space: normal; color: rgb(201, 211, 208); }
.muted { color: rgb(166, 185, 184); font-size: 13px; white-space: normal; }
.primary { height: 58px; background-color: rgb(239, 192, 97); color: rgb(29, 45, 47); border-width: 0; border-radius: 10px; font-size: 19px; -unity-font-style: bold; margin-top: 25px; margin-bottom: 10px; }
.primary:hover { background-color: rgb(255, 216, 136); color: rgb(29, 45, 47); }
.secondary { height: 48px; background-color: rgba(86, 116, 119, .45); color: rgb(244, 236, 216); border-width: 1px; border-color: rgba(237, 231, 209, .2); border-radius: 10px; font-size: 16px; margin-top: 8px; }
.hub-locations { position: absolute; right: 40px; top: 120px; width: 285px; background-color: rgba(21, 38, 44, .86); border-radius: 16px; padding: 20px; }
.section-title { font-size: 20px; -unity-font-style: bold; margin-bottom: 15px; color: rgb(243, 229, 192); }
.location-card { height: 78px; background-color: rgba(77, 100, 100, .32); border-width: 1px; border-color: rgba(174, 190, 170, .17); border-radius: 9px; margin-bottom: 10px; padding: 12px; align-items: flex-start; -unity-text-align: middle-left; }
.location-card.selected { background-color: rgba(191, 148, 65, .25); border-color: rgb(218, 180, 93); }
.location-title { font-size: 17px; -unity-font-style: bold; color: rgb(250, 239, 211); }
.location-detail { font-size: 12px; margin-top: 6px; color: rgb(182, 203, 196); }
.hub-footer { position: absolute; bottom: 28px; left: 50px; right: 45px; flex-direction: row; justify-content: space-between; }
.status-pill { background-color: rgba(24, 42, 45, .83); border-radius: 10px; font-size: 14px; padding: 13px 20px; color: rgb(231, 224, 201); }
.overlay { position: absolute; top: 0; bottom: 0; left: 0; right: 0; background-color: rgba(13, 26, 31, .65); align-items: center; justify-content: center; }
.modal { width: 980px; max-width: 96%; max-height: 94%; background-color: rgb(26, 45, 50); border-radius: 20px; border-width: 1px; border-color: rgba(224, 203, 151, .33); padding: 25px; }
.modal-header { flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 18px; }
.modal-title { font-size: 30px; -unity-font-style: bold; color: rgb(247, 233, 197); }
.row { flex-direction: row; }
.column { flex-direction: column; }
.spaced { justify-content: space-between; }
.grow { flex-grow: 1; }
.selection-bar { flex-direction: row; margin-bottom: 15px; }
.choice { height: 46px; padding-left: 20px; padding-right: 20px; margin-right: 8px; background-color: rgb(43, 64, 67); color: rgb(224, 230, 216); border-width: 1px; border-color: rgba(185, 199, 191, .15); border-radius: 8px; font-size: 15px; }
.choice.selected { background-color: rgb(123, 111, 64); border-color: rgb(242, 199, 105); color: rgb(255, 245, 214); }
.opponent-card { width: 205px; min-height: 106px; margin-right: 12px; padding: 12px; background-color: rgb(45, 69, 69); border-radius: 10px; border-width: 1px; border-color: rgba(185, 199, 191, .15); align-items: flex-start; -unity-text-align: middle-left; }
.opponent-card.selected { border-color: rgb(242, 199, 105); background-color: rgb(70, 79, 62); }
.npc-name { font-size: 22px; -unity-font-style: bold; margin-bottom: 8px; color: rgb(246, 232, 199); }
.npc-desc { font-size: 13px; white-space: normal; color: rgb(191, 207, 198); }
.divider { height: 1px; margin-top: 15px; margin-bottom: 18px; background-color: rgba(183, 200, 185, .18); }
.cards-row { flex-direction: row; flex-wrap: wrap; }
.pog-choice { width: 128px; height: 155px; margin-right: 10px; margin-bottom: 10px; padding: 8px; border-radius: 10px; background-color: rgb(40, 61, 64); border-width: 1px; border-color: rgba(201, 210, 193, .18); align-items: center; }
.pog-choice.selected { border-color: rgb(250, 200, 100); background-color: rgb(71, 78, 58); }
.pog-art { width: 100px; height: 100px; background-size: contain; background-position: center; background-repeat: no-repeat; }
.pog-name { font-size: 13px; margin-top: 8px; color: rgb(239, 228, 202); }
.label-caption { font-size: 13px; margin-bottom: 12px; color: rgb(197, 211, 200); white-space: normal; }
.warning { color: rgb(246, 180, 107); white-space: normal; font-size: 14px; margin-top: 8px; }
.collection { position: absolute; left: 30px; right: 30px; top: 85px; bottom: 30px; background-color: rgba(24, 43, 49, .97); border-radius: 18px; padding: 25px; }
.collection-main { flex-direction: row; flex-grow: 1; min-height: 0; }
.collection-grid { flex-grow: 1; min-width: 360px; }
.collection-grid .pog-choice { width: 128px; height: 156px; }
.locked { opacity: .26; }
.detail-scroll { width: 350px; min-width: 350px; margin-left: 15px; }
.detail { padding: 20px; background-color: rgb(35, 57, 60); border-radius: 12px; }
.detail-art { width: 210px; height: 210px; align-self: center; background-size: contain; background-position: center; background-repeat: no-repeat; margin-bottom: 16px; }
.memory-art { height: 440px; background-size: contain; background-position: center; background-repeat: no-repeat; }
.detail-name { font-size: 27px; -unity-font-style: bold; color: rgb(249, 235, 199); margin-bottom: 8px; }
.detail-text { font-size: 14px; white-space: normal; color: rgb(198, 216, 208); margin-top: 10px; }
.match-top { position: absolute; top: 25px; left: 34px; right: 34px; flex-direction: row; justify-content: space-between; align-items: center; }
.scoreboard { background-color: rgba(20, 38, 44, .93); border-radius: 14px; padding: 16px 28px; min-width: 400px; align-items: center; }
.score { font-size: 37px; -unity-font-style: bold; color: rgb(247, 211, 139); letter-spacing: 5px; }
.rule-caption { font-size: 13px; color: rgb(188, 211, 202); margin-top: 4px; }
.turn-label { position: absolute; top: 138px; left: 29%; right: 29%; font-size: 17px; color: rgb(242, 230, 198); -unity-text-align: middle-center; padding: 10px 14px; border-radius: 9px; background-color: rgba(21, 38, 42, .83); }
.match-bottom { position: absolute; bottom: 24px; left: 36px; right: 36px; min-height: 130px; border-radius: 15px; background-color: rgba(21, 39, 46, .95); padding: 17px 25px; }
.shot-buttons { flex-direction: row; align-items: center; }
.shot-button { width: 122px; height: 54px; border-radius: 9px; margin-right: 10px; background-color: rgb(43, 68, 72); border-width: 1px; border-color: rgba(215, 222, 190, .2); color: rgb(231, 229, 206); font-size: 16px; }
.shot-button.selected { background-color: rgb(121, 107, 59); border-color: rgb(246, 201, 105); }
.power-wrap { width: 260px; margin-left: 20px; }
.power-title { font-size: 12px; margin-bottom: 7px; color: rgb(200, 215, 202); }
.power-bar { height: 10px; background-color: rgb(56, 77, 78); border-radius: 5px; }
.power-fill { height: 10px; background-color: rgb(239, 188, 90); border-radius: 5px; width: 0; }
.message { font-size: 14px; white-space: normal; color: rgb(209, 222, 213); margin-top: 14px; }
.highlight { position: absolute; top: 35%; left: 0; right: 0; -unity-text-align: middle-center; -unity-font-style: bold; font-size: 50px; color: rgb(255, 225, 151); text-shadow: 0 3px 8px rgba(0,0,0,.7); }
.result { width: 560px; background-color: rgb(24, 45, 50); border-radius: 22px; border-width: 1px; border-color: rgb(177, 147, 82); padding: 36px; align-items: stretch; }
.result-title { font-size: 42px; -unity-font-style: bold; color: rgb(249, 215, 150); margin-bottom: 14px; }
.result-score { font-size: 26px; margin-bottom: 14px; color: rgb(200, 220, 209); }
.debug { position: absolute; top: 125px; left: 30px; padding: 12px; background-color: rgba(7, 18, 24, .90); width: 280px; font-size: 13px; color: rgb(175, 235, 190); }
.layout-picker { flex-direction: row; align-items: center; margin-top: 3px; margin-bottom: 9px; height: 36px; color: rgb(238, 232, 207); }
.layout-options { flex-direction: row; align-items: center; margin-top: 3px; margin-bottom: 9px; height: 36px; }
.lobby-modal { padding: 20px; }
.layout-options .choice { height: 36px; font-size: 14px; min-width: 145px; }
.layout-caption { width: 65px; font-size: 14px; color: rgb(238, 232, 207); }
.layout-picker .unity-base-field__label { min-width: 65px; font-size: 14px; }
.layout-picker .unity-base-field__input { background-color: rgb(49, 69, 68); color: rgb(241, 224, 182); border-width: 1px; border-color: rgb(113, 125, 103); border-radius: 7px; height: 34px; padding-left: 12px; }
.collection-filters { flex-direction: row; align-items: center; margin-bottom: 18px; }
.collection-filters .choice { height: 38px; font-size: 14px; }
.empty-caption { padding: 25px; font-size: 16px; white-space: normal; color: rgb(193, 204, 186); }
.wear-track { height: 4px; margin-top: 14px; background-color: rgb(61, 80, 77); border-radius: 2px; }
.wear-fill { height: 4px; background-color: rgb(199, 167, 105); border-radius: 2px; }
.history-title { font-size: 16px; color: rgb(230, 207, 163); margin-top: 22px; margin-bottom: 7px; }
.history-entry { font-size: 13px; color: rgb(180, 199, 190); white-space: normal; margin-bottom: 7px; }
.challenge-modal { width: 1040px; }
.challenge-options { flex-direction: row; margin-top: 14px; margin-bottom: 20px; }
.challenge-card { width: 232px; height: 290px; margin-right: 12px; padding: 14px; background-color: rgb(40, 63, 64); border-radius: 12px; border-width: 1px; border-color: rgb(82, 104, 96); align-items: center; }
.challenge-card.selected { border-color: rgb(243, 200, 110); background-color: rgb(67, 77, 60); }
.challenge-card .section-title { font-size: 20px; margin-bottom: 4px; }
.challenge-card .detail-text { font-size: 13px; }
.layout-diagram { width: 164px; height: 164px; margin-bottom: 12px; align-items: center; justify-content: center; }
.diagram-circle { width: 154px; height: 154px; border-radius: 77px; border-width: 2px; border-color: rgb(173, 187, 158); background-color: rgb(35, 54, 53); }
.diagram-marble { position: absolute; width: 12px; height: 12px; border-radius: 6px; background-color: rgb(88, 195, 182); border-width: 2px; border-color: rgb(221, 236, 200); }
.diagram-pog { position: absolute; width: 20px; height: 20px; border-radius: 10px; background-color: rgb(230, 181, 95); }
.audio-panel { width: 650px; }
.volume-row { margin-top: 12px; margin-bottom: 13px; }
.volume-caption { color: rgb(237, 223, 188); font-size: 16px; margin-bottom: 5px; }
.volume-slider { height: 30px; }
.volume-slider .unity-base-slider__tracker { height: 5px; background-color: rgb(71, 96, 94); border-radius: 3px; }
.volume-slider .unity-base-slider__dragger { width: 18px; height: 18px; background-color: rgb(239, 199, 118); border-radius: 9px; border-width: 0; margin-top: -6px; }
.audio-panel .muted { margin-top: 20px; }
ScrollView .unity-scroller--vertical { width: 10px; }
ScrollView .unity-scroller--horizontal { height: 10px; }
ScrollView .unity-scroller__low-button, ScrollView .unity-scroller__high-button { display: none; }
ScrollView .unity-base-slider__tracker { background-color: rgb(34, 54, 56); }
ScrollView .unity-base-slider__dragger { background-color: rgb(111, 135, 116); border-radius: 5px; border-width: 0; }

/* 0.4：界面保持清楚的层次，玩法信息不挤进场景。 */
.v04-hero { top: 104px; bottom: 108px; width: 430px; padding: 24px; }
.v04-hero .hero-title { font-size: 60px; margin-bottom: 4px; }
.v04-hero .eyebrow { margin-bottom: 12px; }
.v04-hero .hero-subtitle { font-size: 20px; margin-bottom: 12px; }
.v04-hero .body { margin-bottom: 8px; }
.v04-hero .primary { height: 49px; margin-top: 12px; margin-bottom: 5px; font-size: 17px; }
.v04-hero .secondary { height: 44px; margin-top: 8px; margin-bottom: 2px; font-size: 15px; }
.v04-hero .muted { margin-top: 15px; }
.route-buttons { flex-direction: row; flex-wrap: wrap; align-items: center; }
.route-buttons > Button { flex-grow: 1; min-width: 100px; margin-right: 8px; margin-left: 0; }
.route-buttons .small-button { font-size: 13px; padding-left: 10px; padding-right: 10px; margin-top: 12px; }
.v04-locations { top: 104px; bottom: 108px; width: 285px; right: 36px; padding: 17px; }
.v04-locations .section-title { margin-bottom: 10px; }
.v04-locations .location-card { height: 61px; flex-shrink: 0; margin-bottom: 7px; padding: 9px; }
.v04-locations .location-title { font-size: 16px; }
.v04-locations .location-detail { font-size: 11px; margin-top: 3px; }
.wallet-pill { border-radius: 10px; padding: 13px 20px; background-color: rgb(52, 85, 80); color: rgb(247, 225, 168); font-size: 17px; -unity-font-style: bold; }
.v04-page { bottom: 22px; padding: 22px; }
.story-card { width: 46%; min-height: 165px; margin-right: 2%; margin-bottom: 16px; padding: 18px; background-color: rgb(37, 61, 65); border-radius: 13px; border-width: 1px; border-color: rgb(76, 109, 104); align-items: flex-start; -unity-text-align: upper-left; }
.story-card .section-title { font-size: 22px; margin-bottom: 6px; white-space: normal; }
.story-card .detail-text { margin-top: 4px; }
.story-card:disabled { opacity: .48; }
.boss-card { border-color: rgb(209, 165, 82); background-color: rgb(69, 68, 50); }
.story-dialogue { font-size: 18px; color: rgb(237, 221, 182); white-space: normal; padding: 17px 20px; background-color: rgb(37, 60, 61); border-left-width: 3px; border-left-color: rgb(211, 170, 91); border-radius: 10px; margin-bottom: 15px; }
.contract-banner { background-color: rgb(45, 72, 73); color: rgb(220, 237, 221); padding: 12px 17px; margin-bottom: 14px; border-radius: 10px; font-size: 17px; -unity-font-style: bold; white-space: normal; flex-shrink: 0; }
.real-contract { background-color: rgb(116, 56, 45); color: rgb(255, 225, 174); border-width: 1px; border-color: rgb(221, 143, 79); }
.lobby-modal > .primary { flex-shrink: 0; margin-top: 12px; margin-bottom: 4px; }
.lobby-modal > .route-buttons { flex-shrink: 0; }
.lobby-modal .opponent-card { width: 192px; min-height: 88px; margin-bottom: 10px; }
.lobby-modal .selection-bar { flex-wrap: wrap; }
.lobby-modal .choice { margin-bottom: 7px; }
.instance-choice { height: 186px; }
.instance-choice .warning { font-size: 11px; margin-top: 4px; }
.instance-choice .muted { font-size: 11px; }
.shop-card { width: 172px; height: 220px; padding: 12px; }
.shop-card .pog-art { width: 116px; height: 116px; }
.shop-card .pog-name { white-space: normal; -unity-text-align: middle-center; }
.shop-card .warning { font-size: 13px; }
.shop-card .detail-text { font-size: 12px; }
.errand-card { padding: 18px; background-color: rgb(37, 60, 64); border-radius: 13px; margin-bottom: 18px; }
.errand-card .secondary { max-width: 360px; }
.settings-panel { width: 760px; padding: 22px 28px; }
.settings-panel .section-title { margin-bottom: 9px; }
.settings-panel .volume-row { margin-top: 5px; margin-bottom: 8px; }
.settings-panel .divider { margin-top: 13px; margin-bottom: 10px; }
.settings-panel .secondary { margin-top: 8px; margin-bottom: 0; }
.priority-panel { width: 660px; max-width: 94%; background-color: rgb(41, 51, 51); border-radius: 18px; border-width: 3px; border-color: rgb(245, 172, 86); padding: 32px; }
.priority-copy { font-size: 23px; white-space: normal; color: rgb(255, 232, 188); margin-top: 14px; line-height: 32px; }
.priority-panel .small-button { margin-left: 0; margin-top: 12px; }
Button:disabled { opacity: .45; }

/* 0.5：手工纸模与微缩玩具视觉。使用较短的面板、明确的纸张暖色和汽水橙动作色，
   让比赛中央区域保持可见，避免 UI 只剩一整块深色矩形。 */
.topbar { top: 20px; left: 30px; right: 30px; height: 42px; }
.brand { background-color: rgba(38, 48, 42, .86); color: rgb(255, 244, 218); border-radius: 7px; border-left-width: 3px; border-left-color: rgb(236, 177, 76); letter-spacing: 2px; }
.top-actions .small-button { height: 36px; min-width: 78px; padding-left: 13px; padding-right: 13px; margin-left: 6px; background-color: rgba(48, 65, 57, .9); border-color: rgba(239, 207, 151, .38); border-radius: 7px; font-size: 13px; }
.top-actions .small-button:hover { background-color: rgb(84, 106, 83); border-color: rgb(245, 195, 94); }
.hub-hero, .v04-hero { background-color: rgba(36, 51, 45, .91); border-left-color: rgb(234, 174, 71); border-radius: 12px; box-shadow: 0 10px 28px rgba(14, 22, 20, .28); }
.hero-title { color: rgb(255, 243, 211); letter-spacing: 3px; }
.hero-subtitle { color: rgb(247, 222, 170); }
.primary { background-color: rgb(239, 190, 91); color: rgb(46, 52, 39); border-radius: 7px; box-shadow: 0 3px 0 rgba(126, 83, 35, .36); }
.primary:hover { background-color: rgb(255, 214, 127); }
.secondary, .small-button { border-radius: 7px; background-color: rgba(65, 86, 76, .86); border-color: rgba(220, 207, 164, .31); }
.secondary:hover, .small-button:hover { background-color: rgb(85, 108, 92); }
.hub-locations, .v04-locations { background-color: rgba(38, 53, 48, .9); border-radius: 12px; box-shadow: 0 10px 26px rgba(16, 24, 21, .2); }
.location-card { background-color: rgba(90, 110, 89, .3); border-radius: 7px; border-color: rgba(239, 220, 171, .22); }
.location-card.selected { background-color: rgba(201, 153, 63, .34); border-color: rgb(240, 190, 87); }
.status-pill, .wallet-pill { background-color: rgba(45, 75, 65, .92); border-radius: 7px; }
.modal, .collection, .detail, .result { border-radius: 12px; background-color: rgb(38, 57, 52); border-color: rgba(239, 204, 139, .42); box-shadow: 0 12px 32px rgba(12, 23, 21, .3); }
.modal-title, .section-title, .detail-name { color: rgb(255, 237, 194); }
.choice, .opponent-card, .pog-choice, .story-card, .challenge-card, .errand-card, .detail { border-radius: 7px; background-color: rgb(48, 72, 65); border-color: rgba(225, 215, 174, .24); }
.choice.selected, .opponent-card.selected, .pog-choice.selected, .story-card.selected, .challenge-card.selected { background-color: rgb(104, 101, 67); border-color: rgb(245, 198, 100); }
/* 卡面微对比度曾用 USS filter 实现，但构建版不含滤镜着色器会空引用（见 AGENTS.md）；等效处理请烘进贴图。 */
.overlay { background-color: rgba(18, 31, 27, .58); }
.match-top { top: 20px; left: 26px; right: 26px; }
.scoreboard { min-width: 330px; padding: 12px 22px; border-radius: 9px; background-color: rgba(34, 54, 49, .92); border-top-width: 2px; border-top-color: rgb(239, 187, 83); }
.turn-label { top: 118px; background-color: rgba(35, 53, 48, .84); border-radius: 7px; }
.match-bottom { left: 26px; right: 26px; bottom: 18px; min-height: 108px; padding: 13px 20px; border-radius: 10px; background-color: rgba(35, 54, 49, .9); border-top-width: 2px; border-top-color: rgba(236, 184, 79, .55); }
.shot-button { width: 112px; height: 48px; border-radius: 7px; background-color: rgb(54, 83, 74); }
.shot-button.selected { background-color: rgb(113, 105, 62); border-color: rgb(246, 200, 101); }
.power-bar { background-color: rgb(72, 92, 78); border-radius: 4px; }
.power-fill { background-color: rgb(239, 190, 87); border-radius: 4px; }
.highlight { font-size: 44px; color: rgb(255, 220, 132); text-shadow: 0 3px 7px rgba(15, 23, 20, .75); }
.settings-panel { border-radius: 12px; background-color: rgb(39, 58, 52); }
.priority-panel, .toy-dialog { border-radius: 12px; background-color: rgb(45, 59, 52); border-color: rgb(239, 178, 75); box-shadow: 0 12px 35px rgba(11, 18, 15, .4); }
.toy-dialog__title { color: rgb(255, 230, 171); }
.toy-dialog__body { font-size: 17px; line-height: 25px; color: rgb(222, 229, 205); white-space: normal; margin-top: 10px; }
.toy-actions { margin-top: 14px; }
.toy-button { border-radius: 7px; min-height: 44px; }
.toy-button--danger { background-color: rgb(183, 88, 56); color: rgb(255, 239, 209); border-color: rgb(226, 132, 77); }
.toy-button--danger:hover { background-color: rgb(211, 107, 66); }
.view-toggle { min-width: 120px; }
.view-toggle.top-down { background-color: rgb(106, 103, 62); border-color: rgb(244, 199, 97); color: rgb(255, 243, 202); }
.guided-practice { position: absolute; top: 154px; left: 30px; width: 284px; padding: 16px; background-color: rgba(31, 51, 43, .95); border-left-width: 3px; border-left-color: rgb(236, 179, 79); border-radius: 8px; }
.guided-practice .section-title { font-size: 19px; margin-bottom: 8px; }
.guided-practice .detail-text { font-size: 16px; line-height: 24px; margin-top: 0; color: rgb(255, 237, 194); }
.guided-practice .guided-action { height: 45px; margin-top: 14px; margin-bottom: 0; font-size: 17px; }
.guided-score { font-size: 27px; letter-spacing: 1px; }
.guided-power-bar { height: 14px; margin-top: 3px; overflow: visible; }
.guided-power-bar .power-fill { height: 14px; }
.guided-power-range { position: absolute; left: 25%; width: 53%; top: -3px; bottom: -3px; border-width: 2px; border-color: rgb(177, 240, 198); background-color: rgba(164, 238, 190, .12); border-radius: 4px; }
.guided-power-status { font-size: 13px; white-space: normal; color: rgb(255, 228, 172); margin-top: 8px; }
.guided-power-ready { color: rgb(184, 247, 201); }

/* 0.5.3：独立手机界面，480 逻辑高度。短卡片、大字和左右拇指操作。 */
.mobile-ui Label { font-size: 18px; color: rgb(239, 233, 207); margin: 0; padding: 0; }
.mobile-ui Button { min-height: 52px; font-size: 22px; margin: 0; padding: 8px 12px; border-width: 1px; border-color: rgba(224, 215, 171, .35); border-radius: 10px; background-color: rgb(53, 80, 69); color: rgb(255, 242, 212); white-space: nowrap; flex-shrink: 0; }
.mobile-ui Button:hover { background-color: rgb(76, 102, 81); border-color: rgb(241, 193, 100); }
.mobile-ui Button:active { background-color: rgb(108, 115, 78); }
.mobile-ui Button:disabled { opacity: .58; }
.mobile-ui .mobile-primary { height: 56px; min-height: 56px; background-color: rgb(242, 191, 90); border-color: rgb(255, 219, 139); color: rgb(42, 52, 40); -unity-font-style: bold; }
.mobile-ui .mobile-primary:hover { background-color: rgb(255, 214, 120); }
.mobile-ui .mobile-secondary, .mobile-ui .mobile-choice { height: 52px; min-height: 52px; }
.mobile-ui .mobile-choice.selected, .mobile-ui .mobile-copy-choice.selected, .mobile-ui .mobile-location-card.selected { background-color: rgb(108, 103, 63); border-color: rgb(250, 205, 107); color: rgb(255, 246, 206); }
.mobile-ui .mobile-topbar { position: absolute; top: 12px; left: 14px; right: 14px; height: 52px; flex-direction: row; align-items: center; }
.mobile-ui .mobile-nav-title-frame { background-color: rgba(31, 48, 39, .9); padding: 8px 15px; border-radius: 9px; border-left-width: 3px; border-left-color: rgb(244, 191, 85); max-width: 55%; }
.mobile-ui .mobile-nav-title { font-size: 26px; -unity-font-style: bold; color: rgb(255, 243, 206); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.mobile-ui .mobile-wallet { font-size: 20px; color: rgb(249, 220, 159); padding: 12px 14px; background-color: rgba(39, 65, 51, .95); border-radius: 10px; }
.mobile-ui .mobile-page { position: absolute; top: 76px; left: 14px; right: 14px; bottom: 12px; min-width: 0; min-height: 0; }
.mobile-ui .mobile-page-card, .mobile-ui .mobile-collection-preview { border-radius: 12px; border-width: 1px; border-color: rgba(226, 208, 157, .34); background-color: rgba(35, 58, 46, .96); }
.mobile-ui .mobile-kicker, .mobile-ui .mobile-tile-number { color: rgb(228, 182, 109); font-size: 18px; }
.mobile-ui .mobile-tile-number { display: none; }
.mobile-ui .mobile-section-title, .mobile-ui .mobile-preview-title { font-size: 24px; -unity-font-style: bold; color: rgb(255, 237, 189); }
.mobile-ui .mobile-caption, .mobile-ui .mobile-tile-caption { font-size: 18px; color: rgb(198, 217, 197); white-space: normal; }
.mobile-ui .mobile-detail-copy { font-size: 20px; color: rgb(229, 233, 208); white-space: normal; }
.mobile-ui .mobile-reward, .mobile-ui .mobile-price, .mobile-ui .mobile-card-action, .mobile-ui .mobile-story-action { color: rgb(255, 210, 120); -unity-font-style: bold; }
.mobile-ui .mobile-empty { font-size: 24px; padding: 28px 20px; background-color: rgba(38, 58, 46, .95); border-radius: 12px; white-space: normal; }
.mobile-ui .mobile-hub-welcome { border-left-width: 3px; border-left-color: rgb(240, 185, 85); border-radius: 12px; background-color: rgba(32, 52, 42, .94); }
.mobile-ui .mobile-home-title { color: rgb(255, 235, 178); -unity-font-style: bold; margin-top: 10px; margin-bottom: 4px; }
.mobile-ui .mobile-place-name { color: rgb(255, 243, 207); -unity-font-style: bold; }
.mobile-ui .mobile-home-status { color: rgb(233, 207, 151); }
.mobile-ui .mobile-hub-tile { background-color: rgba(42, 64, 49, .97); border-color: rgba(238, 214, 156, .42); border-left-width: 4px; }
.mobile-ui .mobile-tile-title { color: rgb(255, 240, 200); -unity-font-style: bold; margin-top: 3px; margin-bottom: 3px; }
.mobile-ui .mobile-tile-story { border-left-color: rgb(243, 189, 94); }
.mobile-ui .mobile-tile-tournament { border-left-color: rgb(221, 150, 93); }
.mobile-ui .mobile-tile-collection { border-left-color: rgb(141, 193, 164); }
.mobile-ui .mobile-tile-shop { border-left-color: rgb(231, 194, 130); }
.mobile-ui .mobile-tile-errands { border-left-color: rgb(137, 184, 180); }
.mobile-ui .mobile-tile-practice { border-left-color: rgb(184, 184, 120); }
.mobile-ui .mobile-location-grid { background-color: transparent; }
.mobile-ui .mobile-location-card { min-height: 66px; padding: 6px 12px; }
.mobile-ui .mobile-location-title { color: rgb(255, 238, 193); -unity-font-style: bold; }
.mobile-ui .mobile-collection { top: 76px; left: 14px; right: 14px; bottom: 12px; background-color: transparent; border-width: 0; border-radius: 0; }
.mobile-ui .mobile-collection-card { align-items: center; justify-content: center; background-color: rgba(44, 67, 54, .96); }
.mobile-ui .mobile-collection-card.selected { background-color: rgb(98, 100, 61); border-width: 2px; border-color: rgb(255, 207, 99); }
.mobile-ui .mobile-collection-card.locked { opacity: .7; }
.mobile-ui .mobile-card-count { color: rgb(204, 216, 188); }
.mobile-ui .mobile-preview-art, .mobile-trade-art { background-size: contain; background-position: center; background-repeat: no-repeat; }
.mobile-ui .mobile-preview-status { color: rgb(247, 207, 135); }
.mobile-ui .mobile-pager { height: 52px; min-height: 52px; margin-top: 8px; flex-shrink: 0; flex-direction: row; align-items: center; justify-content: center; }
.mobile-ui .mobile-pager Button { width: 130px; height: 52px; font-size: 20px; }
.mobile-ui .mobile-page-number { width: 96px; font-size: 20px; -unity-text-align: middle-center; background-color: rgba(33, 52, 42, .9); height: 42px; border-radius: 8px; margin-left: 10px; margin-right: 10px; }
.mobile-ui .mobile-sheet { width: 760px; max-width: 94%; height: 88%; max-height: 430px; padding: 14px 16px; border-radius: 14px; border-width: 2px; border-color: rgb(219, 171, 85); background-color: rgb(35, 55, 44); }
.mobile-ui .mobile-dialog-header { height: 52px; min-height: 52px; flex-shrink: 0; flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 12px; }
.mobile-ui .mobile-dialog-header > Label { flex-grow: 1; min-width: 0; max-width: 82%; white-space: normal; }
.mobile-ui .mobile-sheet-scroll { flex-grow: 1; min-height: 0; padding-right: 5px; }
.mobile-ui .mobile-fixed-sheet-actions { height: 56px; min-height: 56px; flex-shrink: 0; flex-direction: row; justify-content: center; margin-top: 12px; }
.mobile-ui .mobile-menu-row { flex-direction: row; margin-top: 12px; margin-bottom: 0; flex-shrink: 0; }
.mobile-ui .mobile-menu-row > Button { flex-grow: 1; flex-basis: 0; margin-right: 8px; height: 56px; min-height: 56px; }
.mobile-ui .mobile-memory-art { height: 260px; background-size: contain; background-position: center; background-repeat: no-repeat; flex-shrink: 0; }
.mobile-ui .mobile-lobby-choices { padding: 0 10px; border-radius: 12px; background-color: rgba(32, 53, 43, .97); }
.mobile-ui .mobile-lobby-summary .mobile-contract { margin-bottom: 4px; font-size: 20px; }
.mobile-ui .mobile-opponent-card, .mobile-ui .mobile-story-card, .mobile-ui .mobile-stake-card, .mobile-ui .mobile-shop-card { background-color: rgba(41, 67, 53, .97); }
.mobile-ui .mobile-story-card { border-left-width: 4px; border-left-color: rgb(230, 180, 91); }
.mobile-ui .mobile-story-status, .mobile-ui .mobile-lobby-footer { background-color: rgba(29, 49, 37, .96); border-radius: 10px; padding-left: 12px; padding-right: 8px; }
.mobile-ui .mobile-story-card.boss-card { border-left-color: rgb(248, 151, 92); background-color: rgb(75, 67, 44); }
.mobile-ui .mobile-story-card:disabled, .mobile-ui .mobile-shop-card:disabled { opacity: 1; background-color: rgb(43, 53, 43); border-color: rgb(101, 118, 91); }
.mobile-ui .mobile-story-card:disabled Label, .mobile-ui .mobile-shop-card:disabled Label { color: rgb(176, 189, 169); }
.mobile-ui #mobile-errands > Label { padding: 8px 12px; background-color: rgba(29, 49, 37, .96); border-radius: 10px; }
.mobile-ui .mobile-shop-card .pog-name { -unity-text-align: middle-center; }
.mobile-ui .mobile-shop-card .mobile-price { margin-top: 12px; margin-bottom: 8px; }
.mobile-ui .mobile-tournament-round { background-color: rgb(45, 71, 56); }
.mobile-ui .mobile-tournament-round.selected { border-color: rgb(242, 194, 97); background-color: rgb(103, 98, 58); }
.mobile-ui .mobile-match-top { position: absolute; top: 12px; left: 14px; right: 14px; height: 84px; flex-direction: row; justify-content: space-between; align-items: flex-start; }
.mobile-ui .mobile-match-top > Button { width: 122px; height: 52px; }
.mobile-ui .mobile-scoreboard { width: 390px; max-width: 54%; padding: 5px 16px; align-items: center; background-color: rgba(31, 51, 41, .95); border-top-width: 3px; border-top-color: rgb(237, 185, 80); border-radius: 12px; }
.mobile-ui .mobile-score { font-size: 28px; -unity-font-style: bold; color: rgb(255, 220, 141); }
.mobile-ui .mobile-score-line { flex-direction: row; align-items: center; }
.mobile-ui .mobile-score-line .mobile-rule-caption { margin-left: 16px; }
.mobile-ui .mobile-rule-caption { font-size: 20px; color: rgb(196, 219, 194); }
.mobile-ui .mobile-turn-label { font-size: 20px; color: rgb(250, 237, 202); }
.mobile-ui .mobile-match-left, .mobile-ui .mobile-match-right { position: absolute; bottom: 14px; border-radius: 12px; padding: 10px; background-color: rgba(31, 52, 40, .94); border-width: 1px; border-color: rgba(235, 207, 147, .35); }
.mobile-ui .mobile-match-left { left: 14px; width: 164px; }
.mobile-ui .mobile-match-right { right: 14px; width: 244px; }
.mobile-ui .mobile-match-left .mobile-kicker { margin-bottom: 6px; -unity-text-align: middle-center; }
.mobile-ui .mobile-shot-button { width: auto; height: 52px; min-height: 52px; font-size: 22px; margin-right: 0; margin-top: 6px; }
.mobile-ui .mobile-shot-button.selected { color: rgb(255, 240, 193); background-color: rgb(113, 105, 57); border-color: rgb(255, 208, 96); }
.mobile-ui .mobile-control-pair { flex-direction: row; margin-bottom: 8px; }
.mobile-ui .mobile-action-button { flex-grow: 1; flex-basis: 0; min-width: 0; min-height: 52px; height: 52px; padding: 6px 4px; font-size: 22px; margin-right: 4px; }
.mobile-ui .mobile-action-cancel { background-color: rgb(141, 72, 47); }
.mobile-ui .mobile-power-bar { height: 12px; margin-top: 7px; background-color: rgb(67, 88, 67); border-radius: 6px; overflow: hidden; }
.mobile-ui .mobile-power-fill { width: 0; height: 12px; background-color: rgb(251, 195, 82); border-radius: 6px; }
.mobile-ui .mobile-aim-hint { font-size: 20px; color: rgb(208, 226, 203); margin-top: 10px; -unity-text-align: middle-center; white-space: normal; }
.mobile-ui .mobile-match-feedback { position: absolute; bottom: 14px; left: 194px; right: 274px; padding: 8px 12px; border-radius: 10px; background-color: rgba(27, 45, 35, .78); }
.mobile-ui .mobile-match-message, .mobile-ui .mobile-guided-message { font-size: 20px; white-space: normal; -unity-text-align: middle-center; }
.mobile-ui .mobile-guided-message { color: rgb(255, 219, 139); margin-bottom: 7px; }
.mobile-ui .mobile-guided-feedback { padding: 10px 14px; }
.mobile-ui .mobile-guided-feedback .guided-action { min-height: 48px; height: 48px; margin-top: 8px; font-size: 21px; }
.mobile-ui .mobile-guided-feedback .guided-power-status { font-size: 18px; line-height: 23px; margin-top: 5px; }
.mobile-ui .mobile-guided-feedback .guided-power-range { top: -3px; bottom: -3px; }
.mobile-ui .mobile-match-right .guided-power-bar { margin-top: 5px; }
.mobile-ui .highlight { font-size: 34px; top: 26%; }
.mobile-ui .mobile-settings-panel { width: 760px; max-width: 94%; padding: 16px 20px; border-radius: 14px; border-width: 2px; border-color: rgb(227, 181, 97); background-color: rgb(33, 54, 42); }
.mobile-ui .mobile-settings-content { margin-top: 6px; }
.mobile-ui .mobile-volume-pair { flex-direction: row; }
.mobile-ui .mobile-volume-pair .volume-row { flex-grow: 1; flex-basis: 0; padding: 10px 12px; margin: 6px 4px; background-color: rgb(45, 68, 51); border-radius: 10px; }
.mobile-ui .volume-caption { font-size: 22px; margin-bottom: 6px; }
.mobile-ui .volume-slider { height: 44px; min-height: 44px; }
.mobile-ui .volume-slider .unity-base-slider__tracker { height: 8px; }
.mobile-ui .volume-slider .unity-base-slider__dragger { width: 30px; height: 30px; border-radius: 15px; margin-top: -11px; }
.mobile-ui .mobile-pause-panel { width: 660px; max-width: 94%; padding: 22px; border-radius: 14px; background-color: rgb(35, 55, 43); border-width: 2px; border-color: rgb(234, 184, 87); }
.mobile-ui .mobile-dialog-title { font-size: 30px; -unity-font-style: bold; color: rgb(255, 229, 164); margin-bottom: 12px; white-space: normal; }
.mobile-ui .mobile-result-page { flex-direction: row; }
.mobile-ui .mobile-result-copy { width: 60%; padding: 20px; background-color: rgba(34, 55, 44, .97); border-radius: 14px; }
.mobile-ui .mobile-result-scroll { flex-grow: 1; min-height: 0; }
.mobile-ui .mobile-result-actions { flex-grow: 1; margin-left: 12px; justify-content: center; padding: 18px; border-radius: 14px; background-color: rgba(34, 55, 44, .97); }
.mobile-ui .mobile-result-actions > Button { height: 56px; margin-bottom: 12px; }
.mobile-ui .result, .mobile-ui .toy-dialog { width: 640px; max-width: 94%; padding: 24px; }
.mobile-ui .modal-title { font-size: 28px; }
.mobile-ui .body, .mobile-ui .toy-dialog__body { font-size: 20px; white-space: normal; }
.mobile-ui .result .primary, .mobile-ui .result .secondary { min-height: 56px; height: 56px; font-size: 22px; }
.mobile-ui .result > Button { max-width: 400px; align-self: center; width: 100%; }
.mobile-ui .priority-panel { width: 700px; max-width: 94%; max-height: 92%; padding: 20px; }
.mobile-ui .priority-scroll { flex-grow: 1; min-height: 0; }
.mobile-ui .priority-copy { font-size: 20px; margin-top: 8px; margin-bottom: 12px; }
.mobile-ui .priority-scroll Button { height: 56px; max-width: 400px; font-size: 22px; margin-top: 8px; }
.mobile-ui .toy-button--danger { background-color: rgb(170, 81, 47); color: rgb(255, 236, 200); border-color: rgb(230, 142, 75); }

/* 0.5.6：底部直接调站位与片角，场地中央继续留给出手。 */
.match-bottom .power-wrap { width: 200px; flex-shrink: 0; }
.shot-setup-panel { padding: 0; flex-shrink: 0; }
.desktop-shot-setup { width: 304px; margin-left: 22px; padding-left: 16px; border-left-width: 1px; border-left-color: rgba(229, 208, 155, .22); }
.shot-setup-header { flex-direction: row; align-items: center; height: 32px; }
.shot-setup-title { flex-grow: 1; font-size: 16px; -unity-font-style: bold; color: rgb(255, 226, 159); }
.shot-setup-reset, .shot-setup-close { min-height: 32px; height: 32px; margin: 0; padding: 2px 9px; font-size: 14px; border-radius: 5px; background-color: rgb(55, 78, 62); border-width: 1px; border-color: rgba(229, 208, 155, .25); color: rgb(245, 233, 199); }
.shot-setup-reset:hover, .shot-setup-close:hover { background-color: rgb(83, 101, 70); }
.shot-setup-reset:disabled { opacity: .5; }
.shot-setup-restriction { font-size: 12px; color: rgb(250, 217, 139); margin-top: 2px; margin-bottom: 3px; }
.shot-setup-row { flex-direction: row; align-items: center; height: 26px; }
.shot-setup-value { width: 98px; flex-shrink: 0; font-size: 16px; color: rgb(221, 231, 202); white-space: nowrap; }
.shot-setup-slider { flex-grow: 1; min-width: 0; height: 26px; margin: 0; }
.shot-setup-slider .unity-base-slider__tracker { height: 4px; background-color: rgb(74, 99, 78); border-radius: 2px; }
.shot-setup-slider .unity-base-slider__dragger { width: 15px; height: 15px; background-color: rgb(246, 197, 96); border-radius: 8px; border-width: 0; margin-top: -5px; }
.shot-setup-slider:disabled { opacity: .48; }
.shot-camera-help { min-width: 275px; margin-left: 22px; flex-grow: 1; font-size: 14px; line-height: 22px; white-space: normal; color: rgb(201, 220, 197); }
.mobile-ui .mobile-shot-setup-toggle { height: 48px; min-height: 48px; margin-top: 10px; font-size: 19px; padding: 6px 4px; background-color: rgb(74, 91, 63); }
.mobile-ui .mobile-shot-setup { position: absolute; left: 14px; bottom: 14px; width: 318px; max-width: 44%; padding: 10px 12px; border-radius: 12px; background-color: rgba(31, 52, 40, .97); border-width: 1px; border-color: rgba(235, 207, 147, .42); }
.mobile-ui .shot-setup-header { height: 44px; margin-bottom: 5px; }
.mobile-ui .shot-setup-title { font-size: 21px; }
.mobile-ui .shot-setup-reset, .mobile-ui .shot-setup-close { height: 44px; min-height: 44px; font-size: 19px; padding: 3px 8px; margin-left: 6px; }
.mobile-ui .shot-setup-restriction { font-size: 18px; margin-bottom: 6px; }
.mobile-ui .shot-setup-row { height: 44px; }
.mobile-ui .shot-setup-value { width: 109px; font-size: 18px; }
.mobile-ui .shot-setup-slider { height: 44px; }
.mobile-ui .shot-setup-slider .unity-base-slider__tracker { height: 6px; }
.mobile-ui .shot-setup-slider .unity-base-slider__dragger { width: 28px; height: 28px; border-radius: 14px; margin-top: -11px; }
.mobile-ui #mobile-match.mobile-setup-open .mobile-match-feedback { left: 346px; }
